# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/redirect
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/redirect
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/auth/redirect
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/auth/redirect
NEXT_PUBLIC_CLERK_FALLBACK_REDIRECT_URL=/auth/redirect
NEXT_PUBLIC_CLERK_FORCE_REDIRECT_URL=/auth/redirect
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth/redirect
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/auth/redirect

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/bizfinder

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mapbox / Map Provider (Optional, Leaflet works out-of-the-box with OpenStreetMap tiles)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Cloudinary Image Storage (https://cloudinary.com)
# Required for business image uploads. Get your API Key at:
# https://console.cloudinary.com → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
